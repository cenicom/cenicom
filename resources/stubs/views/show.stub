<x-layout.app>

    <x-slot:title>
        Ver [[ singular ]]
    </x-slot:title>

    <div class="cn-page">

        <x-cn.navigation.breadcrumb :items="[
            ['label' => 'Inicio', 'url' => '/', 'current' => false],
            ['label' => '[[ plural ]]', 'url' => null, 'current' => false],
            ['label' => 'Detalle de [[ singular ]]', 'url' => null, 'current' => true],
        ]" />

        <header class="cn-page-header">

            <div class="cn-page-title">

                <div>

                    <h1>
                        Detalle de [[ singular ]]
                    </h1>

                    <p>
                        Consulte la información registrada del elemento.
                    </p>

                </div>

            </div>

        </header>

        <section class="cn-card">

            <div class="cn-card-body">

                <x-cn.forms.group columns="2">

                    [[ columns ]]

                </x-cn.forms.group>

                <x-cn-form-actions>

                    <x-cn.button
                        :href="route('[[ routeName ]].edit', $[[ model ]])">

                        Actualizar

                    </x-cn.button>

                    <x-cn.button
                        :href="route('[[ routeName ]].index')"
                        variant="secondary">

                        Regresar

                    </x-cn.button>

                </x-cn-form-actions>

            </div>

        </section>

    </div>

</x-layout.app>
