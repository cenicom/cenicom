<x-layout.app>
    <x-slot:title>
        [[ title ]]
    </x-slot:title>

    <div class="cn-page">

        <x-cn.navigation.breadcrumb :items="[
            ['label' => 'Inicio', 'url' => '/', 'current' => false],
            ['label' => '[[ plural ]]', 'url' => null, 'current' => true],
        ]" />

        <x-cn.crud
            title="[[ plural ]]"
            subtitle="[[ description ]]">

            {{-- Toolbar --}}
            <x-slot:toolbar>
                <x-cn.crud.toolbar>

                    <x-cn.button.create
                        :href="route('[[ routeName ]].create')" />

                </x-cn.crud.toolbar>
            </x-slot:toolbar>
            {{-- Filters --}}
            <x-slot:filters>

                <x-cn.crud.filters :action="route('[[ routeName ]].index')">
                    {{-- filtros personalizados --}}
                </x-cn.crud.filters>

            </x-slot:filters>

            {{-- Tabla principal --}}
            <x-cn.table data-cn-datatable>

                <thead>
                    <tr>

[[ table_columns ]]

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @forelse ($[[ collection ]] as $[[ model ]])

                        <tr>

[[ table_cells ]]

                            <td class="text-center">

                                <x-cn.crud.actions>

                                    <x-cn.button.show
                                        :href="route('[[ routeName ]].show', $[[ model ]])" />

                                    <x-cn.button.edit
                                        :href="route('[[ routeName ]].edit', $[[ model ]])" />

                                    <x-cn.crud.confirm
                                        id="delete-[[ model ]]-{{ $[[ model ]]->id }}"
                                        form-id="delete-[[ model ]]-{{ $[[ model ]]->id }}-form"
                                        title="Eliminar [[ singular ]]"
                                        message="¿Está seguro de eliminar este registro?">

                                        <form
                                            id="delete-[[ model ]]-{{ $[[ model ]]->id }}-form"
                                            action="{{ route('[[ routeName ]].destroy', $[[ model ]]) }}"
                                            method="POST">

                                            @csrf
                                            @method('DELETE')

                                        </form>

                                    </x-cn.crud.confirm>

                                </x-cn.crud.actions>

                            </td>

                        </tr>

                    @empty

                        <tr>

                            <td colspan="[[ columnCount ]]">

                                <x-cn.empty-state>
                                    No existen registros.
                                </x-cn.empty-state>

                            </td>

                        </tr>

                    @endforelse

                </tbody>

            </x-cn.table>

            {{-- Footer --}}
            <x-slot:footer>

                <x-cn.crud.pagination
                    :paginator="$[[ collection ]]" />

            </x-slot:footer>

        </x-cn.crud>

    </div>

</x-layout.app>
