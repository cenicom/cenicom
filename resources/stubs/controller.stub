<?php

declare(strict_types=1);

namespace [[ namespace ]];

use App\Http\Controllers\Controller;
use [[ qualifiedServiceInterface ]];
use [[ qualifiedStoreRequest ]];
use [[ qualifiedUpdateRequest ]];
use [[ qualifiedModel ]];
use [[ qualifiedAction ]];
use Illuminate\Http\RedirectResponse;
use Illuminate\View\View;

/**
 * ==========================================================
 * CENICOM ERP
 * ==========================================================
 *
 * Controlador del módulo [[ model ]].
 *
 * Gestiona las operaciones CRUD del módulo.
 *
 * @package [[ namespace ]]
 */
final class [[ controller ]] extends Controller
{
    private const PER_PAGE = 15;

    public function __construct(
        private readonly [[ serviceInterface ]] $service,
        private readonly [[ action ]] $action,
    ) {
    }

    /**
     * Muestra el listado del recurso.
     */
    public function index(): View
    {
        return view('[[ indexView ]]', [
            '[[ pluralVariable ]]' => $this->service->paginate(
                perPage: self::PER_PAGE,
            ),
        ]);
    }

    /**
     * Muestra el formulario de creación.
     */
    public function create(): View
    {
        return view('[[ createView ]]');
    }

    /**
     * Almacena un nuevo recurso.
     */
    public function store(
        [[ storeRequest ]] $request,
    ): RedirectResponse {

        $this->action->create(
            $request->validated()
        );

        return redirect()
            ->route('[[ routeName ]].index')
            ->with('success', '[[ displayName ]] creado correctamente.');
    }

    /**
     * Muestra un recurso específico.
     */
    public function show(
        [[ model ]] $[[ variable ]]
    ): View {

        return view('[[ showView ]]', [
            '[[ variable ]]' => $[[ variable ]],
        ]);
    }

    /**
     * Edita un recurso específico.
     */
    public function edit(
        [[ model ]] $[[ variable ]]
    ): View {

        return view('[[ editView ]]', [
            '[[ variable ]]' => $[[ variable ]],
        ]);
    }

    /**
     * Actualiza un recurso específico.
     */
    public function update(
        [[ updateRequest ]] $request,
        [[ model ]] $[[ variable ]]
    ): RedirectResponse {

        $this->action->update(
            $[[ variable ]]->getKey(),
            $request->validated()
        );

        return redirect()
            ->route('[[ routeName ]].index')
            ->with('success', '[[ displayName ]] actualizado correctamente.');
    }

    /**
     * Elimina el recurso específico.
     */
    public function destroy(
        [[ model ]] $[[ variable ]]
    ): RedirectResponse {

        $this->action->delete(
            $[[ variable ]]->getKey());

        return redirect()
            ->route('[[ routeName ]].index')
            ->with('success', '[[ displayName ]] eliminado correctamente.');
    }
}
